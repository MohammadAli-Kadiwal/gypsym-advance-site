# =============================================================================
# Gypsym Technology: Master Production Environment Configuration Template
# COPY TO .env OR CONFIGURE IN YOUR SECRET MANAGER / CI/CD SECRETS
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Application Core
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME="Gypsym Technology Core API"
PORT=4000
API_PREFIX=/api/v1
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# 2. Database (PostgreSQL 16 & Prisma ORM)
# -----------------------------------------------------------------------------
# Pooled connection string (used by application runtime, e.g. PgBouncer port 6432)
DATABASE_URL=postgresql://gypsym_user:gypsym_password@localhost:5432/gypsym_db?schema=public

# Direct connection string (used by Prisma migrations to bypass poolers, port 5432)
DIRECT_DATABASE_URL=postgresql://gypsym_user:gypsym_password@localhost:5432/gypsym_db?schema=public

# -----------------------------------------------------------------------------
# 3. Authentication & Cryptographic Keys
# -----------------------------------------------------------------------------
# Minimum 32 characters required for cryptographic security (generate via openssl rand -base64 32)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_minimum_32_characters_long_required
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_minimum_32_characters_long_required
JWT_ACCESS_EXPIRES_IN=900s
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# 4. Cross-Origin Resource Sharing (CORS)
# -----------------------------------------------------------------------------
# Comma-separated list of strictly allowed origins (NO wildcard '*' allowed in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# 5. Production Seed & Initial Administrator Bootstrap
# -----------------------------------------------------------------------------
# Used exclusively during database bootstrap/seed. Not needed in normal runtime.
SEED_ADMIN_NAME="MohammadAli Kadiwal"
SEED_ADMIN_EMAIL=chief.architect@gypsym.com
SEED_ADMIN_PASSWORD=YourStrongBootstrapPassword2026!

# -----------------------------------------------------------------------------
# 6. Redis & Session Store
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# 7. Media & Digital Asset Storage (S3 / CloudFront)
# -----------------------------------------------------------------------------
STORAGE_DRIVER=local
S3_BUCKET=gypsym-media-public
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# 8. Transactional Email (SMTP / Amazon SES)
# -----------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=advisory@gypsym.com

# -----------------------------------------------------------------------------
# 9. Security & Cookie Directives
# -----------------------------------------------------------------------------
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# -----------------------------------------------------------------------------
# 10. Next.js Public Client Variables
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="Gypsym Technology"
