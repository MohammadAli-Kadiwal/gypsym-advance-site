# ==============================================================================
# Gypsym Production Environment Configuration
# Copy this to .env on your VPS and update the database password and secrets
# ==============================================================================

NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1

# 1. PostgreSQL Database (Local PostgreSQL on your VPS)
DATABASE_URL="postgresql://gypsym_user:YOUR_SECURE_PASSWORD@localhost:5432/gypsym_db?schema=public"
DIRECT_DATABASE_URL="postgresql://gypsym_user:YOUR_SECURE_PASSWORD@localhost:5432/gypsym_db?schema=public"

# 2. Redis Cache (Local Redis on VPS)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 3. Security Tokens (Generate random 32+ character strings)
JWT_ACCESS_SECRET="gypsym_prod_jwt_access_secret_min_32_characters_random_string_12345"
JWT_REFRESH_SECRET="gypsym_prod_jwt_refresh_secret_min_32_characters_random_string_67890"

# 4. CORS Allowed Origins
CORS_ORIGINS="https://gypsym.com,https://www.gypsym.com,https://admin.gypsym.com"

# 5. Public URLs (Used by Web and Admin next.js frontends)
NEXT_PUBLIC_SITE_URL="https://gypsym.com"
NEXT_PUBLIC_API_URL="https://gypsym.com/api/v1"

# 6. Admin Panel configuration (leave blank if using admin.gypsym.com, or /admin if single-domain subpath)
NEXT_PUBLIC_BASE_PATH=""
