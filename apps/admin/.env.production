NODE_ENV=production
PORT=3001

# Core REST API Endpoint for Admin Operations
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Admin Portal Canonical URL
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Public Site URL (used for "View Live Site", previews, sitemaps, robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Application Branding
NEXT_PUBLIC_APP_NAME="Gypsym Workstation"
