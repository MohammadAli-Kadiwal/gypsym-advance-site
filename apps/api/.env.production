# =============================================================================
# Gypsym Technology: Core API Engine Production Configuration
# Target Domain: https://api.gypsym.com
# =============================================================================

NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1

# Service Topology URLs
APP_URL=https://api.gypsym.com
WEB_URL=https://gypsym.com
ADMIN_URL=https://admin.gypsym.com

# Database Connection (PostgreSQL 16)
DATABASE_URL="postgresql://eunoyaa:Eunoyaa2030@46.202.163.137:5432/gypsym?connection_limit=25&pool_timeout=30"
DIRECT_DATABASE_URL="postgresql://eunoyaa:Eunoyaa2030@46.202.163.137:5432/gypsym?connection_limit=25&pool_timeout=30"

# Authentication & Cryptographic Keys (Production Cryptographic Secrets)
JWT_ACCESS_SECRET="gypsym_jwt_enterprise_cluster_access_secret_2026_secure_key!"
JWT_REFRESH_SECRET="gypsym_jwt_enterprise_cluster_refresh_secret_2026_secure_key!"
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d
SESSION_EXPIRY=7d

# Cross-Origin Resource Sharing (CORS) - Strict White-List for Production
CORS_ORIGINS=https://gypsym.com,https://www.gypsym.com,https://admin.gypsym.com

# Redis & Session Cache (Configure if Redis instance is active)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Media Storage
STORAGE_DRIVER=local
S3_BUCKET=gypsym-media
S3_REGION=us-east-1

# Transactional Email (SMTP / Amazon SES)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=advisory@gypsym.com

# Security Cookies
COOKIE_DOMAIN=.gypsym.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Observability
LOG_LEVEL=info
