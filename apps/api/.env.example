# Environment variables for apps/api
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
DATABASE_URL=postgresql://gypsym_user:gypsym_password@localhost:5432/gypsym_db?schema=public
DIRECT_DATABASE_URL=postgresql://gypsym_user:gypsym_password@localhost:5432/gypsym_db?schema=public
JWT_ACCESS_SECRET=dev_jwt_access_secret_32_characters_minimum_length_required_by_zod
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_32_characters_minimum_length_required_by_zod
JWT_ACCESS_EXPIRES_IN=900s
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
LOG_LEVEL=info
