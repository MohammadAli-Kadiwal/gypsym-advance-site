# =============================================================================
# Gypsym Technology: Public Web Application Production Configuration
# Target Domain: https://www.gypsym.com
# PM2 Port: 3002
# =============================================================================

NODE_ENV=production
PORT=3002

# Canonical Public Website URL
NEXT_PUBLIC_SITE_URL=https://www.gypsym.com
SITE_URL=https://www.gypsym.com

# Core REST API Endpoint (Public: via Nginx /api, Internal SSR: 127.0.0.1:3004)
NEXT_PUBLIC_API_URL=https://www.gypsym.com/api/v1
INTERNAL_API_URL=http://127.0.0.1:3004/api/v1

# Admin Portal URL (Single-Domain Subpath)
NEXT_PUBLIC_ADMIN_URL=https://www.gypsym.com/admin

# Application Branding
NEXT_PUBLIC_APP_NAME="Gypsym Technology"
