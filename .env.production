# =============================================================================
# Gypsym Technology: Monorepo Master Production Environment Configuration
# Target Topology:
#   Web (gypsym.com & www.gypsym.com) : PM2 Port 3002
#   Admin (gypsym.com/admin)          : PM2 Port 3003
#   API Core Engine (gypsym.com/api)  : PM2 Port 3004
# =============================================================================

NODE_ENV=production

# -----------------------------------------------------------------------------
# 1. Domain & Topology Configuration
# -----------------------------------------------------------------------------
APP_URL=https://www.gypsym.com/api
WEB_URL=https://www.gypsym.com
ADMIN_URL=https://www.gypsym.com/admin
SITE_URL=https://www.gypsym.com

NEXT_PUBLIC_SITE_URL=https://www.gypsym.com
NEXT_PUBLIC_ADMIN_URL=https://www.gypsym.com/admin
NEXT_PUBLIC_API_URL=https://www.gypsym.com/api/v1
INTERNAL_API_URL=http://127.0.0.1:3004/api/v1
NEXT_PUBLIC_APP_NAME="Gypsym Technology"

API_PREFIX=/api/v1
PORT=3004
WEB_PORT=3002
ADMIN_PORT=3003
API_PORT=3004

# -----------------------------------------------------------------------------
# 2. Database (PostgreSQL 16)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://eunoyaa:Eunoyaa2030@46.202.163.137:5432/gypsym?connection_limit=25&pool_timeout=30"
DIRECT_DATABASE_URL="postgresql://eunoyaa:Eunoyaa2030@46.202.163.137:5432/gypsym?connection_limit=25&pool_timeout=30"
DIRECT_URL="postgresql://eunoyaa:Eunoyaa2030@46.202.163.137:5432/gypsym?connection_limit=25&pool_timeout=30"

# -----------------------------------------------------------------------------
# 3. Authentication & Cryptographic Keys
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET="gypsym_jwt_enterprise_cluster_access_secret_2026_secure_key!"
JWT_REFRESH_SECRET="gypsym_jwt_enterprise_cluster_refresh_secret_2026_secure_key!"
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d
SESSION_EXPIRY=7d

# -----------------------------------------------------------------------------
# 4. Cross-Origin Resource Sharing (CORS)
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:3003,http://127.0.0.1:3004,https://gypsym.com,https://www.gypsym.com,https://admin.gypsym.com

# -----------------------------------------------------------------------------
# 5. Redis Cache & Queues
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# 6. Object Storage & CDN
# -----------------------------------------------------------------------------
STORAGE_DRIVER=local
S3_BUCKET=gypsym-media
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# 7. Transactional Email
# -----------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=advisory@gypsym.com

# -----------------------------------------------------------------------------
# 8. Security & Cookie Directives
# -----------------------------------------------------------------------------
COOKIE_DOMAIN=.gypsym.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
LOG_LEVEL=info
