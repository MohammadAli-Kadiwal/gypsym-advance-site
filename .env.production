# =============================================================================
# Gypsym Technology: Monorepo Master Production Environment Configuration
# Target Domain: gypsym.com (Web: gypsym.com, Admin: admin.gypsym.com, API: api.gypsym.com)
# =============================================================================

NODE_ENV=production

# -----------------------------------------------------------------------------
# 1. Domain & Topology Configuration
# -----------------------------------------------------------------------------
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
SITE_URL=http://localhost:3000

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="Gypsym Technology"

API_PREFIX=/api/v1
PORT=4000

# -----------------------------------------------------------------------------
# 2. Database (PostgreSQL 16)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://eunoyaa:Eunoyaa2030@46.202.163.137:5432/gypsym?connection_limit=25&pool_timeout=30"
DIRECT_DATABASE_URL="postgresql://eunoyaa:Eunoyaa2030@46.202.163.137:5432/gypsym?connection_limit=25&pool_timeout=30"
DIRECT_URL="postgresql://eunoyaa:Eunoyaa2030@46.202.163.137:5432/gypsym?connection_limit=25&pool_timeout=30"

# -----------------------------------------------------------------------------
# 3. Authentication & Cryptographic Keys
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET="gypsym_jwt_enterprise_cluster_access_secret_2026_secure_key!"
JWT_REFRESH_SECRET="gypsym_jwt_enterprise_cluster_refresh_secret_2026_secure_key!"
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d
SESSION_EXPIRY=7d

# -----------------------------------------------------------------------------
# 4. Cross-Origin Resource Sharing (CORS)
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,https://gypsym.com,https://admin.gypsym.com

# -----------------------------------------------------------------------------
# 5. Redis Cache & Queues
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# 6. Object Storage & CDN
# -----------------------------------------------------------------------------
STORAGE_DRIVER=local
S3_BUCKET=gypsym-media
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# 7. Transactional Email
# -----------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=advisory@gypsym.com

# -----------------------------------------------------------------------------
# 8. Security & Cookie Directives
# -----------------------------------------------------------------------------
COOKIE_DOMAIN=.gypsym.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
LOG_LEVEL=info
